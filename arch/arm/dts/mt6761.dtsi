			reg = <0 0x11009000 0 0x1000>,
				  <0 0x11000180 0 0x0180>;

			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_LOW>;

			clocks = <&infracfg CLK_IFR_I2C_AP>,
				 <&infracfg CLK_IFR_AP_DMA>;
			clock-names = "main", "dma";
