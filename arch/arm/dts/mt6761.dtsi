			compatible = "mediatek,mt6761-disp-aal",
				     "mediatek,mt8183-disp-aal";
			reg = <0 0x14011000 0 0x1000>;

			interrupts = <GIC_SPI 166 IRQ_TYPE_LEVEL_LOW>;

			clocks = <&mmsys CLK_MM_DISP_AAL0>;

			power-domains = <&spm MT6761_POWER_DOMAIN_DISP>;

			mediatek,gce-client-reg = <&gce SUBSYS_1401XXXX 0x1000 0x1000>;
		};

		gamma0: gamma@14012000 {
			compatible = "mediatek,mt6761-disp-gamma",
				     "mediatek,mt8183-disp-gamma";
			reg = <0 0x14012000 0 0x1000>;

			interrupts = <GIC_SPI 167 IRQ_TYPE_LEVEL_LOW>;

			clocks = <&mmsys CLK_MM_DISP_GAMMA0>;

			power-domains = <&spm MT6761_POWER_DOMAIN_DISP>;

			mediatek,gce-client-reg = <&gce SUBSYS_1401XXXX 0x2000 0x1000>;
		};

		dither0: dither@14013000 {
			compatible = "mediatek,mt6761-disp-dither",
				     "mediatek,mt8183-disp-dither";
			reg = <0 0x14013000 0 0x1000>;

			interrupts = <GIC_SPI 168 IRQ_TYPE_LEVEL_LOW>;

			clocks = <&mmsys CLK_MM_DISP_DITHER0>;

			power-domains = <&spm MT6761_POWER_DOMAIN_DISP>;

			mediatek,gce-client-reg = <&gce SUBSYS_1401XXXX 0x3000 0x1000>;
		};

		dsi: dsi@14014000 {
			compatible = "mediatek,mt6761-dsi",
				     "mediatek,mt8183-dsi";
			reg = <0 0x14014000 0 0x1000>;

			interrupts = <GIC_SPI 169 IRQ_TYPE_LEVEL_LOW>;

			clocks = <&mmsys CLK_MM_DSI0>,
				 <&mmsys CLK_MM_DIG_DSI>,
				 <&dsi_phy>;
			clock-names = "engine", "digital", "hs";

			power-domains = <&spm MT6761_POWER_DOMAIN_DISP>;

			phys = <&dsi_phy>;
			phy-names = "dphy";

			#address-cells = <1>;
			#size-cells = <0>;

			resets = <&mmsys MT6761_MMSYS_DSI_RST>;

			status = "disabled";
		};

		camsys: camsys@15000000 {
			compatible = "mediatek,mt6761-camsys", "syscon";
			reg = <0 0x15000000  0 0x1000>;
			#clock-cells = <1>;
		};

		smi_larb2: memory-controller@15001000 {
			compatible = "mediatek,mt6761-smi-larb",
				     "mediatek,mt8192-smi-larb";
			reg = <0 0x15001000 0 0x1000>;

			clocks = <&mmsys CLK_MM_SMI_IMG>,
				 <&camsys CLK_CAM_LARB2>;
			clock-names = "apb", "smi";

			power-domains = <&spm MT6761_POWER_DOMAIN_CAM>;

			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <2>;
		};

		vcodecsys: clock-controller@17000000 {
			compatible = "mediatek,mt6761-vcodecsys", "syscon";
			reg = <0 0x17000000 0 0x10000>;
			#clock-cells = <1>;
		};

		smi_larb1: memory-controller@17010000 {
			compatible = "mediatek,mt6761-smi-larb",
				     "mediatek,mt8192-smi-larb";
			reg = <0 0x17010000 0 0x1000>;

			clocks = <&vcodecsys CLK_VENC_SET0_LARB>,
				 <&vcodecsys CLK_VENC_SET1_VENC>;
			clock-names = "apb", "smi";

			power-domains = <&spm MT6761_POWER_DOMAIN_VCODEC>;

			mediatek,smi = <&smi_common>;
			mediatek,larb-id = <1>;
		};
	};
};